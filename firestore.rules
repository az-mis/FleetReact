rules_version = '2';
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isSuperAdmin() {
      return isSignedIn() && myRole() == 'super_admin';
    }
    function isAdmin() {
      return isSignedIn() && myRole() in ['admin', 'super_admin'];
    }
    function isPlainAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }
    function isOwnProfileEdit(uid) {
      return isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'photoURL', 'photoDriveFileId', 'birthDate', 'address', 'updatedAt']);
    }
    // users/{uid} — profile + role. This is the source of truth for authorization.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSuperAdmin()
        || (isAdmin() && request.resource.data.role == 'driver');
      allow update: if isSuperAdmin()
        || (isAdmin() && resource.data.role == 'driver' && request.resource.data.role == 'driver')
        || isOwnProfileEdit(uid);
      allow delete: if isSuperAdmin();
    }
    match /vehicles/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        && (isSuperAdmin() || request.resource.data.plateNumber == resource.data.plateNumber);
      allow delete: if isAdmin();
    }
    function requestCreateFields() {
      return request.resource.data.keys().hasOnly([
        'requesterName', 'location', 'requesterOffice', 'requesterContact', 'requesterIsPassenger',
        'vehicleId', 'vehiclePlateNumber',
        'defaultDriverId', 'defaultDriverName',
        'purpose', 'destination', 'travelDate', 'travelDateEnd', 'passengers',
        'previousTripTicketDate',
        'status', 'createdAt', 'updatedAt'
      ]);
    }
    function referencedVehicle() {
      return get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data;
    }
    function matchesOrBothEmpty(sent, real) {
      return sent == real || ((sent == null || sent == '') && (real == null || real == ''));
    }
    function referencedVehicleRequest(id) {
      return get(/databases/$(database)/documents/vehicleRequests/$(id)).data;
    }
    match /vehicleRequests/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if requestCreateFields()
        && request.resource.data.status == 'pending'
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() > 0
        && request.resource.data.vehicleId is string
        && request.resource.data.purpose is string
        && request.resource.data.destination is string
        && request.resource.data.travelDate is string
        && request.resource.data.vehiclePlateNumber == referencedVehicle().plateNumber
        && matchesOrBothEmpty(request.resource.data.defaultDriverId, referencedVehicle().assignedDriverId)
        && matchesOrBothEmpty(request.resource.data.defaultDriverName, referencedVehicle().assignedDriverName);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /vehicleAvailability/{id} {
      allow read: if true;
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['vehicleId', 'travelDate', 'travelDateEnd', 'status'])
            && request.resource.data.status == 'pending'
            && referencedVehicleRequest(id).status == 'pending'
            && request.resource.data.vehicleId == referencedVehicleRequest(id).vehicleId
            && request.resource.data.travelDate == referencedVehicleRequest(id).travelDate
            && matchesOrBothEmpty(request.resource.data.travelDateEnd, referencedVehicleRequest(id).travelDateEnd));
      allow update, delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if isSignedIn() || id == 'appBranding';
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isPlainAdmin() && id == 'featureFlags'
            && request.resource.data.adminModules == resource.data.adminModules
            && request.resource.data.adminAnnouncement == resource.data.adminAnnouncement);
      allow delete: if isSuperAdmin();
    }
  }
}
